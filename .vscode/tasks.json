{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Java: Build singcli.jar",
            "type": "process",
            "command": "python3",
            "windows": {
                "command": "python"
            },
            "args": [
                "${workspaceFolder}/scripts/build.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "java",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*\\.java):(\\d+): (warning|error): (.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Java: Run singcli.jar",
            "type": "process",
            "command": "java",
            "args": [
                "-jar",
                "${workspaceFolder}/dist/singcli.jar"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Java: Build singcli.jar",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
